-
	var items = [
		{
			text: "Premium Cars",
			video: "cars",
		},
		{
			text: "Hotels",
			video: "hotels",
		},
		{
			text: "Yachts",
			video: "yachts",
		},
		{
			text: "Spa",
			video: "spa",
		},
		{
			text: "Private Helicopter",
			video: "book/copter",
		},
		{
			text: "Private jet",
			video: "book/jet",
		},
	]
section.book
	.container 
		.book__title
			+title("Book with us", "decor")
		.book__content
			each item in items
				.book__item
					video.book__video(src=`./video/${item.video}.mp4` muted loop) 
					.book__rhomb-box
						.book__rhomb
						span.book__text= item.text