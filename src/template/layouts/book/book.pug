-
	var items = [
		{
			text: "Premium Cars",
			img: "cars",
		},
		{
			text: "Private jet",
			img: "jet",
		},
		{
			text: "Helicopter",
			img: "copter",
		},
		{
			text: "Yachts",
			img: "yachts",
		},
		{
			text: "Hotels",
			img: "villas",
		},
		{
			text: "Best service",
			img: "hotel",
		},
	]

section.book
	.container 
		.book__title
			+title("Book with us", "decor")
		.book__content
			each item in items
				.book__item
					img.book__img(src=`./img/book/${item.img}.webp` alt= item.text) 
					.book__rhomb-box
						.book__rhomb
						span.book__text= item.text