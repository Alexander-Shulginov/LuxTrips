section.reviews 
	+title("Customers reviews", "decor").reviews__title
	.reviews__container
		.reviews__slider.swiper-reviews
			.swiper-wrapper
				.swiper-slide.reviews__item 
					.reviews__photo
						+img("reviews/user-1", "reviews__img", 102, 102, "User photo", "lazy")
					.reviews__typed-wrap
					#typed-string-1
						p
							| “Well organized trip, All arranged well by Arooz. Special thanks to Aijaz Bhai for the service and support given to us, all explained well and take us to all places as per our wish. It was wonderful experience... Thank you team”
							br
							span.reviews__name - Eduard Hand
							span.reviews__location Müller-Egerer
					span.reviews__text#typed-1

				.swiper-slide.reviews__item 
					.reviews__photo
						+img("reviews/user-2", "reviews__img", 102, 102, "User photo", "lazy")
					.reviews__typed-wrap
						.reviews__typed 
							.reviews__dot
							.reviews__dot
							.reviews__dot
						span.reviews__typed-text Typed
					.reviews__hidden#typed-string-2
						p
							| "The trip was meticulously planned and executed flawlessly by the team.
							br
							| Every detail was taken care of, and the support provided by our guide was exceptional. Thank you for a memorable experience!"
							br
							span.reviews__name - Nora Torres
							span.reviews__location Davis Avenue
							
					span.reviews__text#typed-2

				.swiper-slide.reviews__item 
					.reviews__photo
						+img("reviews/user-3", "reviews__img", 102, 102, "User photo", "lazy")
					.reviews__typed-wrap
						.reviews__typed 
							.reviews__dot
							.reviews__dot
							.reviews__dot
						span.reviews__typed-text Typed
					.reviews__hidden#typed-string-3
						p
							| "Our journey was perfectly organized, thanks to the efforts of the team. Special appreciation for the excellent service and guidance throughout.
							br
							| A fantastic experience overall!"
							br
							span.reviews__name - Scott Labbe
							span.reviews__location Inking

					span.reviews__text#typed-3

				.swiper-slide.reviews__item 
					.reviews__photo
						+img("reviews/user-4", "reviews__img", 102, 102, "User photo", "lazy")
					.reviews__typed-wrap
						.reviews__typed 
							.reviews__dot
							.reviews__dot
							.reviews__dot
						span.reviews__typed-text Typed
					.reviews__hidden#typed-string-4
						p
							| "Arooz ensured a well-coordinated trip, and we're grateful for their efforts. The service and support from our guide were outstanding, making our experience truly delightful. Thank you!"
							br
							span.reviews__name - Bradley Thompson
							span.reviews__location Charla Lane

					span.reviews__text#typed-4

	.reviews__contacts 
		include ../../common/contacts/contacts