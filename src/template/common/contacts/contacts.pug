section.contacts#contact
	.contacts__inner 
		video.contacts__video(src="./video/waves.mp4", autoplay, muted, loop) 
		+title("Contact").contacts__title
		form.contacts__form(action="#") 
			input.contacts__input(type="text", required, placeholder="Name")
			input.contacts__input(type="text", required, placeholder="Phone")
			+btn-decor("dark", "Call me back")