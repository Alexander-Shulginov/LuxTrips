---
import ArrowRightSvg from '@/assets/icons/common/arrow-right.svg';
import PlaceCard from './PlaceCard.astro';
import type { RegionTab } from '@/data/places';

interface Props {
	tab: RegionTab;
	index: number;
}

const { tab, index } = Astro.props;
---

<div
	class:list={['tabs__content', { 'tabs__content--visible': index === 0 }]}
	id={`tabpanel-${index + 1}`}
	role="tabpanel"
	aria-labelledby={`tab-${index + 1}`}
>
	<div class="swiper swiper-rated rated__container">
		<div class="swiper-wrapper">
			{tab.items.map((item) => (
				<PlaceCard item={item} folder={tab.folder} />
			))}
		</div>
		<div class="swiper-button-next rated__nav rated__nav--right">
			<ArrowRightSvg class="rated__nav-icon" width="28" height="14" aria-hidden="true" />
		</div>
		<div class="swiper-button-prev rated__nav rated__nav--left">
			<ArrowRightSvg class="rated__nav-icon" width="28" height="14" aria-hidden="true" />
		</div>
	</div>
</div>

<style lang="scss" is:global>
@import 'swiper/swiper.css';
@import 'swiper/css/navigation';
@import 'swiper/css/pagination';

.swiper-pagination-fraction,
.swiper-pagination-custom,
.swiper-horizontal > .swiper-pagination-bullets,
.swiper-pagination-bullets.swiper-pagination-horizontal {
	top: 105%;
	right: unset;
	bottom: unset;
	left: 0;

	display: none;

	margin-top: 12px;
}

.swiper-pagination-bullet {
	width: clamp-px(16, 38);
	height: 2px;

	opacity: 1;
	background: $color-light;
	border-radius: unset;
}

.swiper-pagination-bullet-active {
	background: $color-decor;
}

.swiper-button-prev.swiper-button-disabled,
.swiper-button-next.swiper-button-disabled {
	pointer-events: unset;
	cursor: none;
	opacity: 1;
}

.swiper-button-next,
.swiper-button-prev {
	&::after {
		content: none;
	}

	svg {
		width: unset;
		height: unset;
	}
}

@media (max-width: 1024px) {
	.swiper-button-prev.swiper-button-disabled,
	.swiper-button-next.swiper-button-disabled {
		cursor: pointer;
	}

	.swiper-pagination-fraction,
	.swiper-pagination-custom,
	.swiper-horizontal > .swiper-pagination-bullets,
	.swiper-pagination-bullets.swiper-pagination-horizontal {
		position: relative;
		z-index: 150;
		top: 102%;

		display: block;

		text-align: center;
	}
}
</style>

<style lang="scss">
.rated__container {
	padding: 0 15px;

	@media (min-width: 1440px) {
		margin-left: unset;
	}
}

.rated__nav {
	cursor: none;

	position: absolute;
	transform: rotate(45deg);

	display: flex;
	align-items: center;
	justify-content: center;

	width: clamp-px(40, 57);
	height: clamp-px(40, 57);

	background-color: $color-decor;

	@media (max-width: 1024px) {
		display: none;
		cursor: pointer;
	}
}

.rated__nav-icon {
	transform: rotate(-45deg);

	@media (max-width: 475px) {
		width: 20px;
		height: 10px;
	}
}

.rated__nav--left {
	transform: rotate(225deg) scale(0);

	@media (max-width: 1024px) {
		transform: rotate(225deg) scale(1);
	}
}

.rated__nav--visible {
	transform: rotate(225deg) scale(1.1);
	width: 57px;
}

.rated__nav--hidden {
	width: 0;
	opacity: 0;
	transition: opacity 0.5s ease-in-out, width 0.5s ease-in-out;
}

.swiper-slide {
	border-radius: $radius-base;
	transition: transform 0.6s ease-in-out;

	&:not(:global(.swiper-slide-active)) {
		transform: scale(0.95);
	}
}

.tabs__content {
	position: absolute;
	top: 0;
	right: 0;
	bottom: 0;
	left: 0;

	display: none;

	&--visible {
		display: block;
		animation: show-card 0.7s ease-in-out 0s both;
	}
}

@keyframes show-card {
	from { opacity: 0; }
	to { opacity: 1; }
}
</style>
