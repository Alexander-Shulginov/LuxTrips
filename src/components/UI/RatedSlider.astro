---
import ArrowRightSvg from '@/assets/icons/common/arrow-right.svg';
import PlaceCard from './PlaceCard.astro';
import type { RegionTab } from '@/data/places';

interface Props {
    tab: RegionTab;
    index: number;
}

const { tab, index } = Astro.props;
---

<div class:list={['tabs__content', { 'tabs__content--visible': index === 0 }]} id={`tabpanel-${index + 1}`} role="tabpanel" aria-labelledby={`tab-${index + 1}`}>
    <div class="swiper rated-slider">
        <div class="swiper-wrapper">
            {tab.items.map((item) => <PlaceCard item={item} folder={tab.folder} />)}
        </div>
        <div class="swiper-button-next rated-slider__nav rated-slider__nav--right">
            <ArrowRightSvg class="rated-slider__nav-icon" width="28" height="14" aria-hidden="true" />
        </div>
        <div class="swiper-button-prev rated-slider__nav rated-slider__nav--left">
            <ArrowRightSvg class="rated-slider__nav-icon" width="28" height="14" aria-hidden="true" />
        </div>
    </div>
</div>

<style lang="scss">
    .rated-slider {
        padding: 0 15px;

        @media (min-width: 1440px) {
            margin-left: unset;
        }

        &__nav {
            cursor: none;

            position: absolute;
            transform: rotate(45deg);

            display: flex;
            align-items: center;
            justify-content: center;

            width: clamp-px(40, 57);
            height: clamp-px(40, 57);

            background-color: $color-decor;

            @media (max-width: 1024px) {
                display: none;
                cursor: pointer;
            }

            &-icon {
                transform: rotate(-45deg);

                @media (max-width: 475px) {
                    width: 20px;
                    height: 10px;
                }
            }

            &--left {
                transform: rotate(225deg) scale(0);

                @media (max-width: 1024px) {
                    transform: rotate(225deg) scale(1);
                }
            }

            &--visible {
                transform: rotate(225deg) scale(1.1);
                width: 57px;
            }

            &--hidden {
                width: 0;
                opacity: 0;
                transition:
                    opacity 0.5s ease-in-out,
                    width 0.5s ease-in-out;
            }
        }
    }

    .tabs__content {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;

        display: none;

        &--visible {
            display: block;
            animation: show-card 0.7s ease-in-out 0s both;
        }
    }

    @keyframes show-card {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
