---
interface Props {
    decor?: boolean;
    class?: string;
}

const { decor = false, class: className } = Astro.props;
---

<h2 class:list={['section-title', className]}>
    <slot />
    {
        decor && (
            <svg class="section-title__decor" width="112" height="212" viewBox="0 0 112 212" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M78.3131 148.937L78.3123 148.938L55.9952 191.387L33.4967 148.938L33.4959 148.937L10.8614 105.885L55.9972 20.3808C60.743 29.3622 65.0803 37.5594 69.2532 45.446C79.6419 65.08 89.0122 82.7892 101.132 105.883L78.3131 148.937Z" stroke="white" />
                <path d="M28.5547 53.1765L28.5555 53.1751L56.0014 1.06948L83.6703 53.1751L83.6711 53.1765L111.434 105.884L55.9994 210.699C50.1456 199.642 44.7998 189.557 39.6576 179.857C26.9195 155.828 15.4309 134.156 0.565561 105.885L28.5547 53.1765Z" stroke="white" />
            </svg>
        )
    }
</h2>

<style lang="scss">
    .section-title {
        position: relative;
        z-index: 20;

        font-size: clamp-px(40, 60);
        font-weight: 400;
        line-height: $line-height-base;
        color: $color-dark;
    }

    .section-title__decor {
        position: absolute;
        z-index: -1;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);

        display: none;

        stroke-dasharray: 1966;
        stroke-dashoffset: 1966;

        &--visible {
            display: block;
            animation: decor-draw 10s linear forwards;
        }

        @media (max-width: 768px) {
            width: 106px;
            height: 162px;
        }
    }

    @keyframes decor-draw {
        to {
            stroke-dashoffset: 0;
        }
    }
</style>
