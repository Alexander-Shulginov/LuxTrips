---
import { Image } from 'astro:assets';
import PlaceIconSvg from '@/assets/icons/common/place.svg';
import type { Place } from '@/data/places';

interface Props {
	item: Place;
	folder: string;
}

const { item, folder } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/images/places/**/*.webp',
	{ eager: true }
);
const ratingImages = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/images/places/rating-*.webp',
	{ eager: true }
);

const img = allImages[`/src/assets/images/places/${folder}/${item.img}`]?.default;
const ratingImg = ratingImages[`/src/assets/images/places/rating-${item.rating}.webp`]?.default;
---

<div class="swiper-slide place-card">
	{img && (
		<Image
			class="place-card__img"
			src={img}
			width={350}
			height={570}
			alt="Place photo"
			loading="lazy"
		/>
	)}
	<div class="place-card__inner">
		<div class="place-card__block">
			<div class="place-card__location">
				<PlaceIconSvg class="place-card__mark" width="10" height="10" aria-hidden="true" />
				<address class="place-card__country">{item.country}</address>
			</div>
			<div>
				<h3 class="place-card__name">{item.place}</h3>
			</div>
			<div class="place-card__wrap">
				<div class="place-card__sum">
					<span class="place-card__price">From</span>
					<div class="place-card__value">{item.price}</div>
				</div>
			</div>
		</div>
		<div class="place-card__block">
			<div class="place-card__rating">
				<span class="place-card__rating-num">{item.rating}</span>
				{ratingImg && (
					<Image
						src={ratingImg}
						alt="Place rating"
						height={100}
						width={11}
						loading="lazy"
					/>
				)}
			</div>
		</div>
	</div>
</div>

<style lang="scss">
.place-card {
	position: relative;
	z-index: 500;

	display: flex;
	flex-direction: column;
	justify-content: flex-end;

	height: clamp-px(520, 570);

	&__img {
		position: absolute;

		width: 100%;
		height: 100%;

		object-fit: cover;
		border: 1px solid transparent;
		border-radius: $radius-base;
	}

	&__inner {
		position: relative;
		z-index: 20;

		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		padding: 26px;

		color: $color-light;

		filter: blur(3px);

		transition: all 0.8s ease-in-out;

		:global(.swiper-slide-active) &,
		:global(.swiper-slide-prev) &,
		:global(.swiper-slide-next) & {
			filter: none;
		}

		:global(.swiper-slide-active) & {
			opacity: 1;
		}

		&::after {
			content: '';

			position: absolute;
			z-index: -1;
			top: -100px;
			right: 0;
			bottom: 0;
			left: 0;

			background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, #0b2034 100%);
			border-radius: $radius-base;
		}

		@media (max-width: 768px) {
			opacity: 0;
			padding: 20px;
		}
	}

	&__country {
		font-size: 12px;
		font-weight: 500;
		font-style: normal;
	}

	&__name {
		margin-bottom: 30px;

		font-size: clamp-px(32, 36);
		font-weight: 400;
		line-height: 1;

		transition: opacity 0.8s ease-in-out, font-size 0.8s ease-in-out;
	}

	&__location {
		display: flex;
		gap: 6px;
		align-items: center;
		margin-bottom: 6px;
	}

	&__mark {
		transform: translateY(-2px);
	}

	&__wrap {
		display: flex;
		gap: 22px;
	}

	&__price {
		font-size: 12px;
		font-weight: 500;
		text-transform: uppercase;
	}

	&__value {
		font-size: 24px;
		line-height: 1;
		transition: font-size 0.8s ease-in-out;
	}

	&__rating {
		display: flex;
		flex-direction: column;
		gap: 5px;
		align-items: center;
	}

	&__rating-num {
		font-size: 12px;
		font-weight: 500;
		text-transform: uppercase;
	}
}
</style>
